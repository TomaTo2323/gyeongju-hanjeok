# Railway Variables 예시
APP_ENV=production
LOG_LEVEL=INFO
CORS_ORIGINS=*
# Railway PostgreSQL의 DATABASE_URL 값을 연결
DATABASE_URL=

# 한국관광공사 / 공공데이터
PUBLIC_DATA_SERVICE_KEY=

# Kakao / KMA / OpenAI / Naver / YouTube
KAKAO_REST_API_KEY=
KMA_SERVICE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
YOUTUBE_API_KEY=

# 인증 - 반드시 긴 랜덤 값으로 변경
AUTH_SECRET_KEY=

# 앱 외부 링크: Railway 배포 후 실제 HTTPS 주소로 변경
PUBLIC_INVITE_BASE_URL=
APP_DOWNLOAD_URL=

DAILY_SYNC_ENABLED=true
DAILY_SYNC_HOUR=4
